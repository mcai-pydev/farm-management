{
  "name": "@farm-management/youtube",
  "version": "1.0.0",
  "description": "YouTube integration for farm management system",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@google-cloud/storage": "^6.x",
    "axios": "^1.x",
    "date-fns": "^2.x",
    "dotenv": "^16.x",
    "express": "^4.x",
    "googleapis": "^120.x",
    "winston": "^3.x",
    "zod": "^3.x"
  },
  "devDependencies": {
    "@types/express": "^4.x",
    "@types/jest": "^29.x",
    "@types/node": "^18.x",
    "@typescript-eslint/eslint-plugin": "^5.x",
    "@typescript-eslint/parser": "^5.x",
    "eslint": "^8.x",
    "eslint-config-prettier": "^8.x",
    "eslint-plugin-prettier": "^4.x",
    "husky": "^8.x",
    "jest": "^29.x",
    "lint-staged": "^13.x",
    "prettier": "^2.x",
    "ts-jest": "^29.x",
    "ts-node-dev": "^2.x",
    "typescript": "^4.x"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}